# Environment variables for the Full-Stack Todo app (Phase II).
# Copy this file to `.env` (or your shell rc) and fill in real values.
#
# Next.js (frontend) auto-loads variables from frontend/.env* when run from
# the frontend directory. The FastAPI backend reads the process environment,
# so export these in your shell (or source this file) before `uv run todo-app-api`.

# --- Required (see .specify/features/002-full-stack-todo/quickstart.md) ---

# Neon PostgreSQL connection string (read by Next.js/Better Auth in
# frontend/auth.ts AND by the FastAPI backend in src/todo_app/database.py).
DATABASE_URL=postgresql://user:password@<neon-host>/<dbname>

# Better Auth session-signing secret (read in frontend/auth.ts).
# Generate a stable random value, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=<stable-random-secret>

# --- Optional (sane defaults exist) ---

# Better Auth base URL (frontend/auth.ts). Defaults to http://localhost:3000.
BETTER_AUTH_URL=http://localhost:3000

# JWT JWKS endpoint for RS256 verification (backend auth via JWKS public key).
JWT_JWKS_URL=http://localhost:3000/api/auth/jwks

# JWT issuer and audience values for token verification.
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=todo-app

# Uvicorn listen port (src/todo_app/api/app.py). Defaults to 8000.
PORT=8000

# Uvicorn bind host (src/todo_app/api/app.py). Defaults to 127.0.0.1.
HOST=127.0.0.1

cd D:\Todo_App
uv run --env-file .env todo-app-api